# 应用环境
NODE_ENV=development

# 服务端端口
SERVER_PORT=3000

# PostgreSQL 数据库
DB_HOST=localhost
DB_PORT=5432
DB_USER=xqcop
DB_PASSWORD=xqcop123
DB_NAME=xqcop
DATABASE_URL=postgresql://xqcop:xqcop123@localhost:5432/xqcop?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-it
JWT_EXPIRES_IN=2h

# CORS
CORS_ORIGIN=*

# Flowable 工作流引擎
FLOWABLE_PORT=8080
FLOWABLE_URL=http://localhost:8080/flowable-rest
FLOWABLE_USERNAME=rest-admin
FLOWABLE_PASSWORD=test

# 文件上传
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
UPLOAD_BASE_URL=

# 日志级别
LOG_LEVEL=info
